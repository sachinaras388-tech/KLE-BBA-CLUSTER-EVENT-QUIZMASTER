# Leave EMPTY in the recommended setup (the app calls /api on its own origin; Vercel rewrites /api to Render).
# Only set this if you deliberately call the API on another domain (then set COOKIE_SAMESITE=none on the server).
VITE_API_URL=

# Local dev only: where the Vite dev server proxies /api to.
# VITE_DEV_API=http://localhost:5000
