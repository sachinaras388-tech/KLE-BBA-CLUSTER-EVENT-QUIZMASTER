# ---------- QuizMaster API environment ----------
# Copy to .env for local development. NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Include the database name, e.g. .../quizmaster?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizmaster?retryWrites=true&w=majority

# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session lifetime in hours (cookie + JWT)
JWT_EXPIRES_HOURS=8

# Allowed browser origin(s) for CORS + CSRF origin check. Comma-separated, no trailing slash.
# Production example: https://quizmaster.vercel.app
CLIENT_URL=http://localhost:5173

# Cookie policy.
#  lax  -> use when the browser talks to the API through the Vercel /api rewrite (recommended, same-site)
#  none -> only if the browser calls the Render domain directly (cross-site; needs HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Number of reverse proxies in front of the API (for correct client IPs / rate limiting).
#  1 = browser -> Render directly
#  2 = browser -> Vercel rewrite -> Render
TRUST_PROXY=1

# Password hashing cost (bcrypt). 12 is a good default.
BCRYPT_ROUNDS=12

# Network-latency grace (seconds) accepted after a deadline for the last autosave / submit
SUBMIT_GRACE_SECONDS=5

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Used only by `npm run create-admin` (remove after the admin exists)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=   (min 10 chars, upper+lower+number)
